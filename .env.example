# Copy to .env. Real environment variables override this file.
# Supply your own passwords; do not commit the populated .env file.
APP_ENV=local
SESSION_SECURE=false
APP_PORT=8080

# Native PHP settings. Compose overrides DB_HOST=db and DB_PORT=3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todo_db
DB_USER=todo_app
DB_PASSWORD=

# Used only by the MySQL container; choose a different password from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
